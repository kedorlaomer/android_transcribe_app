+ggml_backend_t decoder_backend_of(const WhisperModel & m) {
+    return m.decoder_backend != nullptr ? m.decoder_backend : m.plan.primary;
+}
+
+transcribe::BackendKind decoder_kind_of(const WhisperModel & m) {
+    return m.decoder_backend != nullptr ? transcribe::BackendKind::Cpu : m.plan.primary_kind;
+}
+
+bool allocate_weights(WhisperModel & m, const char * tag) {
+    ggml_backend_t cpu = m.plan.scheduler_list.empty() ? nullptr : m.plan.scheduler_list.back();
+    const bool     split =
+        transcribe::env::flag("TRANSCRIBE_WHISPER_CPU_DECODER") && cpu != nullptr && cpu != m.plan.primary &&
+        ggml_backend_dev_type(ggml_backend_get_device(cpu)) == GGML_BACKEND_DEVICE_TYPE_CPU &&
+        (m.plan.primary_kind == transcribe::BackendKind::Vulkan ||
+         m.plan.primary_kind == transcribe::BackendKind::OtherGpu);
+    if (!split) {
+        m.backend_buffer = ggml_backend_alloc_ctx_tensors(m.ctx_meta, m.plan.primary);
+        if (m.backend_buffer == nullptr) {
+            return false;
+        }
+        ggml_backend_buffer_set_usage(m.backend_buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        return true;
+    }
+    // Encoder weights (and the mel frontend's) on the primary, decoder
+    // weights on the CPU.
+    std::vector<ggml_tensor *> enc, dec;
+    for (ggml_tensor * t = ggml_get_first_tensor(m.ctx_meta); t != nullptr; t = ggml_get_next_tensor(m.ctx_meta, t)) {
+        (std::strncmp(ggml_get_name(t), "dec.", 4) == 0 ? dec : enc).push_back(t);
+    }
+    m.backend_buffer = ggml_backend_buft_alloc_buffer_n(ggml_backend_get_default_buffer_type(m.plan.primary),
+                                                        enc.data(), static_cast<int>(enc.size()));
+    m.decoder_buffer = ggml_backend_buft_alloc_buffer_n(ggml_backend_get_default_buffer_type(cpu), dec.data(),
+                                                        static_cast<int>(dec.size()));
+    if (m.backend_buffer == nullptr || m.decoder_buffer == nullptr) {
+        return false;
+    }
+    ggml_backend_buffer_set_usage(m.backend_buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    ggml_backend_buffer_set_usage(m.decoder_buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    m.decoder_backend = cpu;
+    log_msg(TRANSCRIBE_LOG_LEVEL_INFO, "%s: encoder on %s, decoder on %s (%zu + %zu tensors)", tag,
+            ggml_backend_name(m.plan.primary), ggml_backend_name(cpu), enc.size(), dec.size());
+    return true;
+}
